<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.doubao</groupId>
        <artifactId>share-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>share-service-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>share-service-server</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.doubao</groupId>
            <artifactId>share-service-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
    </dependencies>
    <profiles>
        <!-- 单体模式 -->
        <profile>
            <id>monolith</id>
            <activation>
                <activeByDefault>true</activeByDefault> <!-- 默认激活 -->
            </activation>
            <dependencies>
                <!-- 仅在单体模式下依赖 user-service -->
                <dependency>
                    <groupId>com.doubao</groupId>
                    <artifactId>user-service-api</artifactId>
                    <version>0.0.1-SNAPSHOT</version>
                </dependency>
                <dependency>
                    <groupId>com.doubao</groupId>
                    <artifactId>quote-service-api</artifactId>
                    <version>0.0.1-SNAPSHOT</version>
                </dependency>
            </dependencies>
            <properties>
                <service.run-mode>monolith</service.run-mode>
            </properties>
        </profile>

        <!-- 微服务模式 -->
        <profile>
            <id>microservice</id>
            <properties>
                <service.run-mode>microservice</service.run-mode>
            </properties>
        </profile>
    </profiles>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>