<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.doubao.share.service.mapper.ShareLinkMapper">

    <!-- ShareLink selectByShareUrl(@Param("shareUrl") String shareUrl); -->
    <select id="selectByShareUrl" resultType="org.doubao.share.service.entity.ShareLink">
        SELECT
        *
        FROM share_link
        WHERE share_url = #{shareUrl}
    </select>
    <!-- List<ShareLink> selectByQuoteId(@Param("quoteId") String quoteId); -->
    <select id="selectByQuoteId" resultType="org.doubao.share.service.entity.ShareLink">
        SELECT
        *
        FROM share_link
        WHERE quote_id = #{quoteId}
    </select>
</mapper>