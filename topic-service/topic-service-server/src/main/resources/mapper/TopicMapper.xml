<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.doubao.topic.service.mapper.TopicMapper">
    <select id="selectTopTopics" resultType="org.doubao.topic.service.vo.TopicSelectVo">
        SELECT
        t.id,
        t.name
        FROM
        topic t
        WHERE
        t.status = 1
        AND t.deleted = 0
        ORDER BY t.weight DESC
        LIMIT #{limit, jdbcType=INTEGER}
    </select>

</mapper>