<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.doubao.dialog.service.mapper.AssistantMessageMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="org.doubao.dialog.service.entity.AssistantMessage">
        <id column="id" property="id"/>
        <result column="dialog_id" property="dialogId"/>
        <result column="sender_type" property="senderType"/>
        <result column="content" property="content"/>
        <result column="send_time" property="sendTime"/>
    </resultMap>

    <!-- 根据对话ID查询最新N条消息 -->
    <select id="selectLastNByDialogId" resultMap="BaseResultMap">
        SELECT
        id,
        dialog_id,
        sender_type,
        content,
        send_time
        FROM
        assistant_message
        WHERE
        dialog_id = #{dialogId}
        ORDER BY
        send_time DESC
        LIMIT #{limit}
    </select>

    <!-- 根据对话ID查询所有消息 -->
    <select id="selectByDialogId" resultMap="BaseResultMap">
        SELECT
        id,
        dialog_id,
        sender_type,
        content,
        send_time
        FROM
        assistant_message
        WHERE
        dialog_id = #{dialogId}
        ORDER BY
        send_time ASC
    </select>

    <!-- 查询对话的最后一条消息 -->
    <select id="selectLastByDialogId" resultMap="BaseResultMap">
        SELECT
        id,
        dialog_id,
        sender_type,
        content,
        send_time
        FROM
        assistant_message
        WHERE
        dialog_id = #{dialogId}
        ORDER BY
        send_time DESC
        LIMIT 1
    </select>

    <!-- 根据关键词搜索消息 -->
    <select id="searchMessages" resultMap="BaseResultMap">
        SELECT
        id,
        dialog_id,
        sender_type,
        content,
        send_time
        FROM
        assistant_message
        WHERE
        content IS NOT NULL
        <if test="keyword != null and keyword != ''">
            AND content LIKE CONCAT('%', #{keyword}, '%')
        </if>
        ORDER BY
        send_time DESC
    </select>

</mapper>
