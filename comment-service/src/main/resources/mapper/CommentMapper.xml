<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.doubao.comment.service.mapper.CommentMapper">

    <!-- List<Comment> selectByPostId(String postId); -->
    <select id="selectByPostId" resultType="org.doubao.comment.service.entity.Comment">
        SELECT
        *
        FROM comments
        WHERE post_id = #{postId}
        ORDER BY created_time DESC
    </select>

    <!-- 查前count条回复 List<Comment> selectReplies(String commentId, int count); -->
    <select id="selectReplies" resultType="org.doubao.comment.service.entity.Comment">
        SELECT
        *
        FROM comments
        WHERE parent_id = #{commentId}
        ORDER BY created_time DESC
        LIMIT #{count}
    </select>

    <!-- 根据主评论ID分页查询回复列表 -->
    <select id="selectRepliesByCommentId" resultType="org.doubao.comment.service.entity.Comment">
        SELECT
        *
        FROM
        comments c
        WHERE
        c.root_id = #{rootId}
        AND c.parent_id IS NOT NULL
        AND c.status = 0
        AND c.deleted = 0
        ORDER BY
        c.created_time DESC
    </select>
</mapper>