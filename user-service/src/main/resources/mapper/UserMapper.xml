<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.doubao.user.server.core.mapper.UserMapper">
    <!-- User findByEmail(@Param("email") String email); -->
    <select id="findByEmail" resultType="org.doubao.user.server.core.entity.User">
        SELECT * FROM user WHERE email = #{email}
    </select>

    <update id="updateUserAvatar">
        UPDATE user SET
            avatar_key = #{fileKey},
            storage_type = #{storageType}
        WHERE id = #{userId}
    </update>

    <update id="updateUserBg">
        UPDATE user SET
            bg_key = #{fileKey},
            storage_type = #{storageType}
        WHERE id = #{userId}
    </update>

    <!-- boolean findByUsername(@Param("username") String username); -->
    <select id="findByUsername" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM user WHERE username = #{username})
    </select>

    <!-- Integer existsByIdAndStatus(@Param("userId") Long userId, @Param("status") int status);-->
    <select id="existsByIdAndStatus" resultType="int">
        SELECT COUNT(*) FROM user WHERE id = #{userId} AND status = #{status}
    </select>

    <!-- boolean existsByNickname(String nickname); -->
    <select id="existsByNickname" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM user WHERE nickname = #{nickname})
    </select>


    <!-- void updateUserPassword(@Param("email") String email, @Param("pwd") String pwd); -->
    <update id="updateUserPassword">
        UPDATE user SET
            password = #{pwd}
        WHERE email = #{email}
    </update>
</mapper>