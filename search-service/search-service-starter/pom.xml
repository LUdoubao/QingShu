<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.doubao</groupId>
        <artifactId>search-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>search-service-starter</artifactId>
    <name>search-service-starter</name>
    <description>Search Service Starter module - executable Spring Boot application</description>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.doubao</groupId>
            <artifactId>search-service-server</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Microservices -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.doubao.search.service.starter.SearchServiceStarter</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>