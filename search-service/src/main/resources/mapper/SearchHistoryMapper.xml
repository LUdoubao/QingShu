<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.doubao.search.service.db.mapper.SearchHistoryMapper">

    <select id="getUserSearchHistory" resultType="org.doubao.search.service.db.entity.SearchHistory">
        SELECT 
            id, 
            user_id, 
            keyword, 
            created_time 
        FROM search_history 
        WHERE user_id = #{userId}
        AND deleted = 0
        ORDER BY created_time DESC
        LIMIT #{limit}
    </select>

</mapper>
