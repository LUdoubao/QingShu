# ============================================
# 基础镜像选择
# ============================================
# openjdk:8-jdk-alpine 是一个轻量级的 Linux 镜像，只包含运行 Java 必需的环境
# alpine 版本体积很小（约 100MB），适合部署
# 注意：alpine 使用 musl libc 而不是 glibc，某些特殊场景可能不兼容
FROM openjdk:8-jdk-alpine

# ============================================
# 作者信息（可选）
# ============================================
LABEL maintainer="3411426617@qq.com"

# ============================================
# 设置时区（重要！避免日志时间不对）
# ============================================
# 安装 tzdata 时区数据包，并设置上海时区
RUN apk add --no-cache tzdata && \
    ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# ============================================
# 创建工作目录
# ============================================
# /app 是容器内的目录，所有文件都放在这里
# 类似于 Windows 的 C:\app
WORKDIR /app

# ============================================
# 复制 jar 包到容器
# ============================================
# 第一个路径是相对于 Dockerfile 的位置（构建时的上下文）
# 第二个路径是容器内的目标位置
# *.jar 表示匹配任何 jar 文件，这样版本号变了也能用
COPY target/*.jar app.jar

# ============================================
# 暴露端口
# ============================================
# 声明容器会监听 9100 端口（只是声明，实际映射在运行时用 -p 参数）
# 这个端口必须和你的 bootstrap.yml 中 server.port 一致
EXPOSE 9100

# ============================================
# 健康检查（可选但推荐）
# ============================================
# 每 30 秒检查一次，超时 3 秒，连续 3 次失败认为不健康
# 健康检查失败的容器会被标记为 unhealthy，方便监控
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# ============================================
# 启动命令
# ============================================
# ENTRYPOINT 是容器启动时执行的命令，不可被覆盖
# 这里使用 java -jar 运行 Spring Boot 应用
# 注意：JDK 1.8 默认垃圾回收器是 Parallel GC，一般不需要额外配置
ENTRYPOINT ["java", "-jar", "app.jar"]
